{
  "name": "mineradio",
  "productName": "Mineradio",
  "version": "2.1.0",
  "description": "Windows 沉浸式音乐播放器，融合桌面模式、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Mineradio",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "npm run test:shared && npm run test:platform && npm run test:build",
    "test:shared": "npm run test:shared:core && npm run test:shared:legacy",
    "test:shared:core": "node --test tests/shared/injected-platform-dependencies.test.js tests/shared/ipc-payload-validation.test.js tests/shared/external-navigation-validation.test.js tests/shared/privileged-ipc-policy.test.js tests/shared/trusted-ipc-main.test.js tests/shared/window-ipc-authorization.test.js tests/contracts/server-local-data-paths.test.js tests/contracts/path-identity.test.js tests/startup-qa-userdata-isolation.test.js tests/external-update-page-bridge.test.js tests/home-daily-recommendation-virtualization.test.js tests/home-daily-recommendations-backend.test.js tests/home-dashboard-update.test.js tests/home-hero-mp4-platform-recommend.test.js tests/local-music-library-persistence.test.js tests/qishui-passport-qr-login.test.js tests/qishui-tier-rights.test.js tests/search-frontend-pagination.test.js tests/ui-default-theme-shelf-layer.test.js tests/update-external-only.test.js",
    "test:shared:legacy": "node scripts/run-legacy-tests.js",
    "test:shared:live": "MINERADIO_LIVE_PROVIDER_SMOKE=1 node tests/qishui-passport-live-smoke.js",
    "test:platform": "node --test tests/contracts/native-desktop-feature-boundary.test.js tests/contracts/platform-contract.test.js tests/contracts/platform-ipc-boundary.test.js tests/contracts/platform-renderer-capabilities.test.js tests/contracts/renderer-platform-ux.test.js tests/contracts/wallpaper-engine-renderer-capability.test.js tests/platform/windows/platform.test.js tests/platform/macos/platform.test.js tests/platform/macos/application-menu.test.js tests/platform/macos/shortcuts.test.js tests/platform/macos/system-memory.test.js",
    "test:smoke:macos": "node --test tests/smoke/macos/main-entry-smoke.test.js && node tests/smoke/macos/main-entry-smoke.js",
    "test:smoke:macos:package": "node --test tests/smoke/macos/packaged-app-smoke.test.js && node tests/smoke/macos/packaged-app-smoke.js",
    "test:build": "node --test tests/build/ci-workflows.test.js tests/build/macos-build.test.js",
    "build:mac": "electron-builder --config electron-builder.macos.js --mac dmg --arm64 --publish never",
    "build:mac:unsigned": "MINERADIO_ALLOW_UNSIGNED_MACOS_BUILD=1 electron-builder --config electron-builder.macos.js --mac dmg --arm64 --publish never",
    "validate:mac:unsigned": "node build/macos/validate-dmg.js --unsigned dist-macos/Mineradio-${npm_package_version}-macOS-arm64.dmg",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never"
  },
  "build": {
    "appId": "com.mineradio.desktop",
    "productName": "Mineradio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "*-api.js",
      "qishui-auth-v6.js",
      "qishui-qr-login.js",
      "qishui-auth-v6/**/*",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "Mineradio",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "Mineradio-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "XxHuberrr",
        "repo": "Mineradio"
      }
    ]
  },
  "mineradio": {
    "update": {
      "provider": "github",
      "owner": "XxHuberrr",
      "repo": "Mineradio",
      "preview": false,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "music-metadata": "11.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
